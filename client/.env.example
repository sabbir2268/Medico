# In development, /api is proxied by Vite to http://localhost:5000.
# In production (Vercel) this MUST be the full backend URL INCLUDING /api, e.g.
# VITE_API_URL=https://medico-api.onrender.com/api
VITE_APP_NAME=Medico
VITE_API_URL=/api
VITE_API_TIMEOUT=15000

# Keep fallback catalog data only for local UI development. Set to false in
# production so real API errors surface instead of being silently hidden.
VITE_USE_FALLBACK_DATA=false

# "firebase" (default) keeps Firebase in charge of email/password auth and
# exchanges the Firebase ID token at POST /api/auth/firebase.
# "backend" uses POST /api/auth/register and POST /api/auth/login instead.
VITE_AUTH_MODE=firebase
# Legacy flag from earlier builds. It is read but no longer used anywhere in
# the app; roles always come from the backend. Safe to omit (or set false).
VITE_ALLOW_FIREBASE_ONLY_AUTH=false

# Hard-coded administrator email. Only this account gets the admin dashboard.
# Keep it identical to ADMIN_EMAIL in server/.env.
VITE_ADMIN_EMAIL=admin@medico.test

# Firebase web config (public config; safe for the browser).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mern-boilerplate.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-mern-boilerplate
VITE_FIREBASE_STORAGE_BUCKET=demo-mern-boilerplate.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Optional: read for compatibility but not used (analytics is not initialized).
VITE_FIREBASE_MEASUREMENT_ID=

# Stripe publishable key (safe for the browser; never put sk_ keys here).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Legacy alias still read for backward compatibility.
VITE_PAYMENT_KEY=pk_test_replace_me

# Optional: only needed if uploads are moved to direct unsigned Cloudinary uploads.
VITE_CLOUDINARY_CLOUD_NAME=
# Legacy, unused by the current signed server-side upload flow.
VITE_IMAGE_UPLOAD_KEY=
