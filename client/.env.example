# In development, /api is proxied by Vite to http://localhost:5000.
# Set this to the full URL when the client is deployed separately.
VITE_APP_NAME=Medico
VITE_API_URL=/api
VITE_API_TIMEOUT=15000

# The homepage keeps a curated catalog in the client so the UI still renders
# while the storefront endpoints are being built. Set to false once the API
# storefront endpoints are live, and real API errors will surface instead.
VITE_USE_FALLBACK_DATA=true

# Firebase web config (required for authentication).
# Copy this file to client/.env and fill in the values from
# Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mern-boilerplate.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-mern-boilerplate
VITE_FIREBASE_STORAGE_BUCKET=demo-mern-boilerplate.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

VITE_PAYMENT_KEY=demo_stripe_payment_key

VITE_IMAGE_UPLOAD_KEY=demo_imgbb_image_uploading_api_key
