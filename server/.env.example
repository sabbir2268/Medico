# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Comma-separated allowed origins. Must be explicit in production (no `*`).
CORS_ORIGIN=http://localhost:5173

# HTTP request logging format: dev, combined, common, short, tiny
MORGAN_FORMAT=dev

# Global /api rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Authentication (Firebase verification + backend JWT)
# ---------------------------------------------------------------------------
# Firebase service account from Firebase console -> Project settings ->
# Service accounts -> Generate new private key. Keep this file secret.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Use \n escapes for line breaks, as exported in the JSON key file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Required in production. Use long random values (e.g. openssl rand -base64 48).
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=medico-api
JWT_AUDIENCE=medico-client

# ---------------------------------------------------------------------------
# Stripe (payments — configured lazily; routes report 503 until set)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------------------------------------------------------------------------
# Cloudinary (image storage — configured lazily)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
